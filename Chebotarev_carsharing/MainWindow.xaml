<Window x:Class="Chebotarev_carsharing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chebotarev_carsharing"
        mc:Ignorable="d"
        Title="Авторизация" Height="600" Width="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="700"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Авторизация"
                   FontSize="40"
                   Foreground="Black"
                   Width="240"
                   HorizontalAlignment="Center"
                   Margin="140 , 30, 0, 0"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="300" HorizontalAlignment="Center" Margin="140, 0, 0, 0">
            <TextBox x:Name="txtUsername"
                     Margin="0, 5, 0, 10"
                     Height="30"
                     Width="250"
                     Background="Azure"
                     Foreground="Gray"
                     Text="Логин"
                     VerticalContentAlignment="Center"
                     GotFocus="txtUsername_GotFocus"
                     LostFocus="txtUsername_LostFocus"/>
                <Grid Width="250" Height="30">
                    <PasswordBox x:Name="txtPassword"
                                 Margin="0, 0"
                                 Height="30"
                                 Width="250"
                                 Background="Beige"
                                 VerticalContentAlignment="Center"
                                 PasswordChanged="txtPassword_PasswordChanged"/>
                <TextBlock x:Name="lblPasswordHint"
                           Text="Пароль"
                           Foreground="Gray"
                           Margin="2, 7, 0, 0"
                           IsHitTestVisible="False"/>
            </Grid>
            <Button Content="Войти"
                    Width="100"
                    Height="25"
                    IsDefault="True"
                    Margin="0, 10"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="140, 0, 0, 0">
            <TextBlock Text="Введите капчу"
                       FontSize="18"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0, 10"/>
            <TextBox x:Name="txtCaptcha"
                     Height="30"
                     Width="250"
                     Background="LightCyan"/>
        </StackPanel>
    </Grid>
</Window>
